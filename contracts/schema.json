{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Energy Tracker SDK contract cases",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "required": [
    "schemaVersion",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "operation": {
          "enum": [
            "devices.listStandard",
            "devices.listVirtual",
            "meterReadings.list",
            "meterReadings.create",
            "meterReadings.delete",
            "meterReadings.export",
            "environments.list",
            "environments.get",
            "environments.create",
            "environments.delete",
            "environments.createEntry",
            "environments.deleteEntry",
            "calculations.dailyValues",
            "calculations.extrapolations"
          ]
        },
        "input": {
          "type": "object"
        },
        "request": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/v[13]/"
            },
            "query": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "$ref": "#/$defs/body"
            }
          },
          "required": [
            "method",
            "path",
            "query",
            "headers",
            "body"
          ],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "$ref": "#/$defs/body"
            }
          },
          "required": [
            "status",
            "headers",
            "body"
          ],
          "additionalProperties": false
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "result": {}
              },
              "required": [
                "result"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "validation",
                        "authentication",
                        "forbidden",
                        "notFound",
                        "conflict",
                        "rateLimit",
                        "unavailable",
                        "api"
                      ]
                    },
                    "status": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "retryAfter": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "status",
                    "messages"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "operation",
        "input",
        "request",
        "response",
        "expected"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "devices.listStandard"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/deviceFilters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "meterReadings.list"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "meterId": {
                    "type": "string"
                  },
                  "sort": {
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "deviceId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "meterReadings.create"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "reading": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  "allowRounding": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "deviceId",
                  "reading"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "meterReadings.delete"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "deviceId",
                  "timestamp"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "meterReadings.export"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "meterId": {
                    "type": "string"
                  },
                  "sort": {
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  },
                  "config": {
                    "type": "object",
                    "properties": {
                      "columns": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "date",
                            "value",
                            "note",
                            "meter_id",
                            "meter_number"
                          ]
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "includeHeader": {
                        "type": "boolean"
                      },
                      "delimiter": {
                        "enum": [
                          "comma",
                          "semicolon",
                          "tab"
                        ]
                      },
                      "dateFormat": {
                        "enum": [
                          "iso",
                          "date_time",
                          "unix",
                          "unix_ms"
                        ]
                      }
                    },
                    "required": [
                      "columns"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "deviceId",
                  "config"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.list"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  }
                },
                "required": [
                  "deviceId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.get"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "environmentId": {
                    "type": "string"
                  }
                },
                "required": [
                  "deviceId",
                  "environmentId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.create"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "record": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "deviceId",
                  "record"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.createEntry"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "environmentId": {
                    "type": "string"
                  },
                  "entry": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "deviceId",
                  "environmentId",
                  "entry"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.deleteEntry"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "environmentId": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "deviceId",
                  "environmentId",
                  "timestamp"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "calculations.dailyValues"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "timeZone": {
                    "type": "string"
                  }
                },
                "required": [
                  "deviceId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "calculations.extrapolations"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "timeZone": {
                    "type": "string"
                  },
                  "method": {
                    "enum": [
                      "standard"
                    ]
                  },
                  "interval": {
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year"
                    ]
                  }
                },
                "required": [
                  "deviceId",
                  "interval"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "devices.listVirtual"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/deviceFilters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "environments.delete"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "environmentId": {
                    "type": "string"
                  }
                },
                "required": [
                  "deviceId",
                  "environmentId"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "json": {}
          },
          "required": [
            "json"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "base64": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "base64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      ]
    },
    "deviceFilters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "folderPath": {
          "type": "string"
        },
        "updatedAfter": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBefore": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
